# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kmen

# JWT Secret (반드시 프로덕션에서 변경)
JWT_SECRET=your-secret-key-change-this

# Admin Account (최초 실행 시 자동 생성)
ADMIN_EMAIL=admin@kmen.kr
ADMIN_PASSWORD=change-this-password

# Server
PORT=3001
NODE_ENV=production

# 업로드 파일 저장 경로 (선택)
# 지정하지 않으면 NODE_ENV=production 일 때 앱 디렉토리 바깥 ../kmen-uploads,
# 그 외에는 프로젝트 안 ./uploads 를 사용한다.
# 배포 환경에서 실행 위치(process.cwd())가 불확실하면 절대경로로 직접 지정할 것.
# UPLOADS_DIR=/home/사용자명/kmen-uploads
